# Copy to .env.local and fill in. NEVER commit real values.
# In Vercel: Project → Settings → Environment Variables (see README).

# --- Public (inlined into the browser bundle) --------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon / publishable key. Safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional browser error tracking.
NEXT_PUBLIC_SENTRY_DSN=

# --- Server only ---------------------------------------------------------------
# Bypasses RLS. Server code only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string (Supavisor, port 6543) for scripts and backups.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Random 32+ character string. Salts hashed session ids and rate-limit keys.
METRICS_SALT=
# Random 32+ character string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Email (Resend). Emails are sent only when RESEND_API_KEY and EMAIL_FROM are
# both set (EMAIL_FROM on the domain verified in Resend). Until then they wait
# in the queue and go out once both are set; after two weeks they are dropped.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# e.g. EMAIL_FROM="AWLEL Journal <no-reply@your-domain.example>"
EDITORIAL_EMAIL=awlel.journal@gmail.com
# Receives operational alerts (site down, failed jobs, backup failures).
ALERT_EMAIL=

# Error tracking and tracing (optional; OpenTelemetry is used when blank).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_LEVEL=info

# --- First Super Admin (used once by `npm run seed:admin`) --------------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
